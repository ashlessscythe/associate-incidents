{
  "name": "associate-incidents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-local-db.mjs -- npm run dev:app",
    "dev:app": "concurrently npm:dev:vite npm:dev:server",
    "dev:vite": "vite",
    "dev:server": "node src/server.js",
    "build": "prisma generate && tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "audit": "node scripts/audit-check.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "server": "node scripts/with-local-db.mjs -- node src/server.js",
    "start": "node scripts/with-local-db.mjs -- npm run start:app",
    "start:app": "prisma migrate deploy && node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/with-local-db.mjs -- prisma migrate deploy",
    "prisma:studio": "node scripts/with-local-db.mjs -- prisma studio",
    "prisma:seed": "node scripts/with-local-db.mjs -- prisma db seed",
    "prisma:seed-admin": "node scripts/with-local-db.mjs -- node prisma/seed-admin.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@faker-js/faker": "^8.4.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@react-pdf/renderer": "^3.4.4",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.416.0",
    "multer": "^2.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-datepicker": "^7.3.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.3",
    "resend": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.26",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18"
  }
}
