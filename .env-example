# Database — use a normal Postgres URL, or a local file-backed PGlite path:
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
DATABASE_URL="file:./.data/local"

# JWT Secret (REQUIRED - must be a strong secret key)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000

# Backup encryption key (REQUIRED - 64 hex characters; generate with: openssl rand -hex 32)
BACKUP_ENCRYPTION_KEY=

# Comma-separated list of allowed browser origins (cross-origin only)
CORS_ORIGIN="http://localhost:5173"

# Set when behind a reverse proxy so rate limiting sees client IPs (e.g. 1)
# TRUST_PROXY=1

RESEND_API_KEY="rekeygoeshere"
EMAIL_FROM="no-reply@example.com"
FRONTEND_URL="http://localhost:5173"
