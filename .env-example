# Database — use a normal Postgres URL, or a local file-backed PGlite path:
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
DATABASE_URL="file:./.data/local"

# JWT Secret (REQUIRED - must be a strong secret key)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=5000

# Backup encryption key (REQUIRED - must be exactly 64 characters)
BACKUP_ENCRYPTION_KEY=your64-character-encryption-key-here-must-be-exactly-64-chars

# Optional: CORS settings
CORS_ORIGIN="http://localhost:5173"

RESEND_API_KEY="rekeygoeshere"
EMAIL_FROM="no-reply@example.com"
FRONTEND_URL="http://localhost:5173"
